#!/usr/bin/env bash
# Qutebrowser userscript: send page/selection text + user input to ollama llama3.2:3b
# Output is inserted into an Emacs buffer named \"*qutebrowser-llam-response*\"
#
# Dependencies: ollama & emacsclient with gptel & ezf
#
# Save to: ~/.local/share/qutebrowser/userscripts/llama_prompt
# Then: chmod +x ~/.local/share/qutebrowser/userscripts/llama_prompt

set -euo pipefail

prompt() {
    USER_INPUT=$(printf '' | ezf)

    # If user cancelled, exit quietly
    if [[ -z ${USER_INPUT:-} ]]; then
	exit 0
    fi

    PROMPT=$(echo "$USER_INPUT" | sed 's/"/\\"/g')

    emacsclient --eval "(with-current-buffer (get-buffer-create \"*qutebrowser-llm-response*\") (org-mode) (gptel-mode) (gptel--apply-preset 'web-agent (lambda (sym val) (set (make-local-variable sym) val))) (insert \"In the browser page:\n\" \"#+begin_src\n\" \"$1\" \"#+end_src\n\n\" \"$PROMPT\") (gptel-send) (switch-to-buffer (current-buffer)))"
}

add-context() {
    FILE="$(mktemp)"
    echo "$1" > "$FILE"
    emacsclient --eval "(gptel-add-file \"$FILE\")"
}


if [[ -n "$QUTE_SELECTED_TEXT" ]]; then
    SOURCE_TEXT="$QUTE_SELECTED_TEXT"
else
    SOURCE_TEXT="$(cat "$QUTE_TEXT")"
fi

CONTEXT=$(echo "$SOURCE_TEXT\n" | sed 's/"/\\"/g')

case "$1" in
    prompt ) prompt "$CONTEXT";;
    context ) add-context "$CONTEXT";;
esac
